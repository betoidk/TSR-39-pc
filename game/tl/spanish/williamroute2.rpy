    # m "\"Mines are dangerous!\""
    m "\"Mines are dangerous!\""

# game/williamroute2.rpy:3546
translate spanish sw2_690a1d7e:

    # m "\"Especially condemned or abandoned ones.\""
    m "\"Especially condemned or abandoned ones.\""

# game/williamroute2.rpy:3547
