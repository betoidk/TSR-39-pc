translate spanish sw2_b7a1aa52:

    # wi "\"Maybe we should have brought a canary.\""
    wi "\"Maybe we should have brought a canary.\""

# game/williamroute2.rpy:3551
translate spanish sw2_dbc46e4e:

    # m "\"Or Professor Tibbits, so he can condemn us when we’re acting crazy.\""
    m "\"Or Professor Tibbits, so he can condemn us when we’re acting crazy.\""

