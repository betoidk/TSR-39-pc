    # ni "\"Thank you for being my friend.\""
    ni "\"Thank you for being my friend.\""

# game/williamroute2.rpy:3463
translate spanish go1_c1dd80f4:

    # "Will lets out another loud sigh, looking down."
    "Will lets out another loud sigh, looking down."

# game/williamroute2.rpy:3465
