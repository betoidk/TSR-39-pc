translate spanish sny5_e1cfef52:

    # "What the Hell is that?"
    "What the Hell is that?"

# game/nikroute3.rpy:11566
translate spanish sny5_d67cc08d:

    # "And why can’t I get up?"
    "And why can’t I get up?"

