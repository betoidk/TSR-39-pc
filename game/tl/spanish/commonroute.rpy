    "Su tela se mueve."

# game/commonroute.rpy:1328
translate spanish commonroute_609bf422:

    # unk "\"Whiff it.\""
    unk "\"Huélelo.\""

# game/commonroute.rpy:1329
translate spanish commonroute_3e774764:

    # "I lean in to obey."
    "Me inclino para obedecer."

# game/commonroute.rpy:1330
translate spanish commonroute_032f6c5b:

