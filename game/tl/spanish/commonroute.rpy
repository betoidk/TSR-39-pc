    "Huele a sudor, a almizcle... muy masculino."

# game/commonroute.rpy:1331
translate spanish commonroute_c92e6b4d:

    # unk "\"No need to build up tension, darlin’. Suck it.\""
    unk "\"No hace falta crear tensión, cariño. Chúpamelo.\""

# game/commonroute.rpy:1335
translate spanish commonroute_af09f49f:

    # "My arms are spread on the bed, holding me stable as I dip down."
    "Tengo los brazos extendidos sobre la cama, sujetándome para mantener el equilibrio mientras me inclino hacia abajo."

# game/commonroute.rpy:1336
translate spanish commonroute_1744dfd9:

    # "His tip is already wet... he needs this..."
    "Su glande ya está húmedo... necesita esto..."

# game/commonroute.rpy:1337
translate spanish commonroute_cb79b5d6:

    # "I hear him suck in air harshly as my lips part."
    "Lo oigo aspirar el aire con fuerza cuando mis labios se separan."

# game/commonroute.rpy:1338
translate spanish commonroute_a8112917:

    # "He’s hot and warm in my mouth."
    "Está caliente y cálido en mi boca."

# game/commonroute.rpy:1339
translate spanish commonroute_73f1b6dc:

    # "My licks are loud and sloppy."
    "Mis lametones son ruidosos y desmañados."

# game/commonroute.rpy:1340
translate spanish commonroute_5a7f8bc3:

    # "He tends to like that."
    "Suele gustarle eso."

# game/commonroute.rpy:1341
translate spanish commonroute_8eabc5d4:

    # "Before long, ropes splash my snout, sinking into my fur."
    "Al poco rato, los chorros me salpican el hocico y se hunden en mi pelaje."

# game/commonroute.rpy:1345
translate spanish commonroute_f97b509b:

    # wi "\"Nothing prettier than white on black.\""
    wi "\"No hay nada más bonito que el blanco sobre el negro.\""

# game/commonroute.rpy:1346
translate spanish commonroute_effa8255:

    # "He drags his dick across my face, smearing the cum into my snout markings."
    "Me pasa la verga por la cara y me unta el semen en las marcas del hocico."

# game/commonroute.rpy:1347
translate spanish commonroute_7a7f98a1:

    # wi "\"You’re good at this.\""
    wi "\"Se te da bien esto.\""

# game/commonroute.rpy:1348
translate spanish commonroute_052ff4be:

    # "I wipe a little off of my snout that’s getting precariously close to my eye."
    "Me limpio un poco el hocico, ya que el líquido se está acercando peligrosamente a mi ojo."

# game/commonroute.rpy:1349
translate spanish commonroute_0e97bf35:

    # m "\"It’s not so difficult.\""
    m "\"No es tan difícil.\""

# game/commonroute.rpy:1354
translate spanish commonroute_b30bbe58:

    # wi "\"Rude to reject a compliment. You’ll do well in my books if you keep pants loose and keep tongues looser.\""
    wi "\"Es de mala educación rechazar un cumplido. Te irá bien conmigo si mantienes los pantalones sueltos y la lengua aún más suelta.\""

# game/commonroute.rpy:1355
translate spanish commonroute_4ac421d1:

    # wi "\"Might even save an innocent man from getting dragged so a murderer can waltz free.\""
    wi "\"Incluso podría evitar que se lleven por delante a un hombre inocente para que un asesino se salga con la suya.\""

# game/commonroute.rpy:1356
translate spanish commonroute_01ae3993:

    # m "\"I’m a whore, not a spy, William.\""
    m "\"Soy una puta, no un espía, William.\""

# game/commonroute.rpy:1357
translate spanish commonroute_acf6cd19:

    # wi "\"Any smart whore is a spy. Smart whores live longer. Especially if the law is in their favor.\""
    wi "\"Cualquier puta lista es una espía. Las putas listas viven más tiempo. Especialmente si la ley está de su lado.\""

# game/commonroute.rpy:1358
translate spanish commonroute_277439dc:

    # wi "\"A blind eye here and there is what you need more than anything.\""
    wi "\"Lo que más necesitas, por encima de todo, es hacer la vista gorda de vez en cuando.\""

# game/commonroute.rpy:1360
translate spanish commonroute_47e07516:

    # "The coyote starts getting dressed."
    "El coyote empieza a vestirse."

# game/commonroute.rpy:1361
translate spanish commonroute_7942ddc4:

    # "He stated that more like a fact than a threat, but I can’t help but feel it’s both."
    "Lo dijo más como un hecho que como una amenaza, pero no puedo evitar sentir que es ambas cosas."

# game/commonroute.rpy:1362
translate spanish commonroute_f63e61bb:

    # "I want to tell him the truth, but I can’t help but feel like that could be the most stupid thing I could ever do."
    "Quiero contarle la verdad, pero no puedo evitar pensar que eso podría ser lo más estúpido que jamás haya hecho."

# game/commonroute.rpy:1363
translate spanish commonroute_582ad0d1:

    # "He does not need to know everything about me."
    "No necesita saberlo todo sobre mí."

# game/commonroute.rpy:1364
translate spanish commonroute_f8c458d4:

    # "William already has his clothes and shirt back on."
    "William ya se volvió a poner la ropa y la camisa."

# game/commonroute.rpy:1367
translate spanish commonroute_6c45875f:

    # wi "\"Do what you do and be my eyes after dark. I can’t keep tabs on as many folks as I’d like with all the new folks moving in.\""
    wi "\"Haz lo que haces y sé mis ojos cuando cae la noche. No puedo vigilar a tanta gente como me gustaría con todos los recién llegados que se están instalando.\""

# game/commonroute.rpy:1369
translate spanish commonroute_aebed5a9:

    # m "\"Why don’t you... do this yourself, if you think it’s so insightful.\""
    m "\"¿Por qué no... lo haces tú mismo, si crees que es tan revelador?\""

# game/commonroute.rpy:1371
translate spanish commonroute_6cf0e6ed:

    # wi "\"Cause I ain't a cocksucker. I already carved out my way to be of use. You, not so much, fella. But it would make both of our lives easier.\""
    wi "\"Porque yo no soy ningún mamavergas. Ya me he abierto camino para ser útil. Tú, no tanto, amigo. Pero nos haría la vida más fácil a los dos.\""

# game/commonroute.rpy:1372
translate spanish commonroute_6b0e9388:

    # m "\"So long as you’re sheriff.\""
    m "\"Mientras seas el sheriff.\""

# game/commonroute.rpy:1374
translate spanish commonroute_44098654:

    # wi "\"So long as I’m sheriff.\""
    wi "\"Mientras yo sea el sheriff.\""

# game/commonroute.rpy:1376
translate spanish commonroute_216e3fcd:

    # "William shakes his shaggy head and grunts, rising from the bed as he pulls on his suspenders."
    "William sacude su cabeza peluda y gruñe, levantándose de la cama mientras se sube los tirantes."

# game/commonroute.rpy:1378
translate spanish commonroute_77935805:

    # wi "\"You’ll learn about the world quick enough. Quicker would be better, I might add.\""
    wi "\"Te vas a enterar del mundo bastante rápido. Y, por cierto, cuanto más rápido, mejor.\""

# game/commonroute.rpy:1380
translate spanish commonroute_e80f5281:

    # "He sighs."
    "Suspira."

# game/commonroute.rpy:1382
translate spanish commonroute_a09704ed:

    # wi "\"Anyway, clean yourself up before you talk to me outside. I need witnesses to a better reason for my visit tonight.\""
    wi "\"En fin, límpiate antes de hablar conmigo fuera. Necesito testigos que confirmen que mi visita de esta noche tiene un motivo más respetable.\""

# game/commonroute.rpy:1384
translate spanish commonroute_f0f1d907:

    # m "\"Okay...\""
    m "\"Está bien...\""

# game/commonroute.rpy:1386
translate spanish commonroute_afd73d09:

    # wi "\"Peaches.\""
    wi "\"Duraznos.\""

# game/commonroute.rpy:1390
translate spanish commonroute_b4dda3bc:

    # "The first thing I do is make my way to the washbowl and start scrubbing."
    "Lo primero que hago es ir al lavamanos y ponerme a frotar."

# game/commonroute.rpy:1391
translate spanish commonroute_d4284ebd:

    # "The water is cloudy soon enough with what William left behind, but the citrus oil masks enough of his smell."
    "Enseguida el agua se enturbia con lo que William dejó, pero el aceite cítrico disimula bastante su olor."

# game/commonroute.rpy:1393
translate spanish commonroute_3cc3e45f:

    # "I grunt when my length presses against the dresser."
    "Gruño cuando mi miembro se apoya contra la cómoda."

# game/commonroute.rpy:1394
translate spanish commonroute_d88787fc:

    # "William doesn’t tend to me finishing before he leaves."
    "William no suele quedarse a esperar a que termine antes de irse."

# game/commonroute.rpy:1395
translate spanish commonroute_87a3b54b:

    # "The clear stain on my trousers has to be taken care of before I go speak with the sheriff in front of others."
    "Tengo que ocuparme de la mancha clara de mis pantalones antes de ir a hablar con el sheriff delante de los demás."

# game/commonroute.rpy:1396
translate spanish commonroute_fc8136c2:

    # "At least I won’t have to wait to be ready for another customer soon."
    "Al menos no tengo que esperar mucho para estar listo para otro cliente."

# game/commonroute.rpy:1400
translate spanish commonroute_9a61188e:

    # "William waits for me at the bar, quietly."
    "William me espera en la barra, en silencio."

# game/commonroute.rpy:1401
translate spanish commonroute_1c46598c:

    # "He’s ordering something, chatting lazily with... that fox from before."
    "Está pidiendo algo y charlando tranquilamente con... ese zorro de antes."

# game/commonroute.rpy:1402
translate spanish commonroute_690e2a72:

    # "I take a seat between the two of them... which they must have arranged for intentionally."
    "Me siento entre los dos... algo que, sin duda, deben haber planeado a propósito."

# game/commonroute.rpy:1404
translate spanish commonroute_55b3183e:

    # wi "\"Let’s get down to business then.\""
    wi "\"Vayamos al grano, entonces.\""

# game/commonroute.rpy:1405
translate spanish commonroute_564fd3ec:

    # "Murdoch sniffs the air."
    "Murdoch huele el aire."

# game/commonroute.rpy:1407
translate spanish commonroute_014ff9c8:

    # mu "\"You mean you hadn’t already?\""
    mu "\"¿Quieres decir que aún no lo habías hecho?\""

# game/commonroute.rpy:1408
translate spanish commonroute_1a30b223:

    # "William shoots him a look."
    "William le lanza una mirada."

# game/commonroute.rpy:1410
translate spanish commonroute_980ed249:

    # wi "\"Not in the least!\""
    wi "\"¡En absoluto!\""

# game/commonroute.rpy:1412
translate spanish commonroute_e9abcc79:

    # wi "\"Alcohol and debauch makes a loon out of a sane man and much worse out of the trash.\""
    wi "\"El alcohol y la juerga convierten a un hombre sensato en un loco y, a la escoria, en algo mucho peor.\""

# game/commonroute.rpy:1414
translate spanish commonroute_52658ec9:

    # wi "\"If our murderer exists, he makes succor out of the best medicine for guilt. Pleasures that distract among people proper society tends to forget.\""
    wi "\"Si nuestro asesino existe, convierte en remedio el que es el mejor bálsamo para la culpa. Placeres que distraen entre las personas y que la sociedad respetable tiende a olvidar.\""

# game/commonroute.rpy:1416
translate spanish commonroute_2691da54:

    # mu "\"Or at least pretend to forget. Proper book keeping covers blind spots.\""
    mu "\"O al menos finge olvidarlo. Una buena contabilidad cubre los puntos ciegos.\""

# game/commonroute.rpy:1417
translate spanish commonroute_a8875731:

    # "I think I’m starting to understand."
    "Creo que empiezo a entender."

# game/commonroute.rpy:1418
translate spanish commonroute_f5d22343:

    # m "\"...Which means you need to meet some of the ladies.\""
    m "\"...Lo que significa que tienes que conocer a algunas de las señoras.\""

# game/commonroute.rpy:1419
translate spanish commonroute_1646bb76:

    # wi "\"They'll give us access to the men.\""
    wi "\"Ellas nos darán acceso a los hombres.\""

# game/commonroute.rpy:1421
translate spanish commonroute_a8b4fa56:

    # "The men I can’t access."
    "Los hombres a los que no puedo acceder."

# game/commonroute.rpy:1422
translate spanish commonroute_f88ecf5e:

    # "But they can’t say that out here, can they?"
    "Pero no pueden decir eso aquí fuera, ¿verdad?"

# game/commonroute.rpy:1425
translate spanish commonroute_22ff4d31:

    # ha "\"You’ll want the powder room, then. Cynthia!\""
    ha "\"Entonces querrás ir al tocador. ¡Cynthia!\""

# game/commonroute.rpy:1427
translate spanish commonroute_1cab3d8c:

    # "The fox hurries our way, ready to lead the way..."
    "La zorra se apresura hacia nosotros, lista para abrirnos el camino..."

# game/commonroute.rpy:1430
translate spanish commonroute_31436222:

    # "I’m not here very often."
    "No vengo aquí muy seguido."

# game/commonroute.rpy:1431
translate spanish commonroute_9c947172:

    # "Usually because I choose not to be."
    "Normalmente porque decido no estarlo."

# game/commonroute.rpy:1432
translate spanish commonroute_bd48023d:

    # "It’s a bit too... periwinkle for me."
    "Es un poco demasiado... color pervinca para mi gusto."

# game/commonroute.rpy:1433
translate spanish commonroute_c03f30dc:

    # "And nothing humbles you more as a whore than a space guaranteed to give you no interested prospective clients."
    "Y, como puta, no hay nada que te humille más que un lugar donde tienes la certeza de que no vas a encontrar ni un solo cliente interesado."

# game/commonroute.rpy:1435
translate spanish commonroute_83d4f8b5:

    # "The girls chatter on sofas while Cynthia leads me to the Madam."
    "Las chicas charlan en los sofás mientras Cynthia me lleva hasta Madam Dora."

# game/commonroute.rpy:1438
translate spanish commonroute_6f75072b:

    # md "\"William.\""
    md "\"William.\""

# game/commonroute.rpy:1441
translate spanish commonroute_f12b3bf1:

    # wi "\"I just need a few words.\""
    wi "\"Solo necesito hablar contigo un momento.\""

# game/commonroute.rpy:1444
translate spanish commonroute_84b00fbd:

    # "Madam places her chin on her wrist as she stares into William's eyes, dark and sparkling in the candlelight."
    "Madam apoya la barbilla en la muñeca mientras mira fijamente a William a los ojos, oscuros y brillantes a la luz de las velas."

# game/commonroute.rpy:1446
translate spanish commonroute_be720fe0:

    # md "\"Pray that they engross me. My attention span is short and my patience for God-fearing men is shorter.\""
    md "\"Reza por que me cautiven. Mi capacidad de atención es limitada y mi paciencia con los hombres temerosos de Dios es aún más limitada.\""

# game/commonroute.rpy:1449
translate spanish commonroute_c9b6a07e:

    # wi "\"I’ll be short, then.\""
    wi "\"Seré breve, entonces.\""

# game/commonroute.rpy:1453
translate spanish commonroute_cfc5ef24:

    # md "\"Your sort usually is.\""
    md "\"La gente de tu tipo suele serlo.\""

# game/commonroute.rpy:1455
translate spanish commonroute_72da458a:

    # "Her gown billows as she rises, and she gestures to a doorway across the hall."
    "Su vestido se agita cuando se levanta, y señala con un gesto una puerta al otro lado del vestíbulo."

# game/commonroute.rpy:1457
translate spanish commonroute_f7bcf494:

    # "She gives William her wrist, he takes it, and she leads him into the office."
    "Ella le ofrece la muñeca a William, él la toma y ella lo conduce al despacho."

# game/commonroute.rpy:1458
translate spanish commonroute_33bea182:

    # "I can almost hear their muffled voices, until a sudden squeak distracts me."
    "Casi puedo oír sus voces apagadas, hasta que un chirrido repentino me distrae."

# game/commonroute.rpy:1460
translate spanish commonroute_000cc2e4:

    # cl "\"You’re here!\""
    cl "\"¡Estás aquí!\""

# game/commonroute.rpy:1461
translate spanish commonroute_4262efa2:

    # "Christ almighty."
    "Por Dios santo."

# game/commonroute.rpy:1463
translate spanish commonroute_1c874007:

    # cy "\"This one has a bit of spunk to him.\""
    cy "\"Este tiene un poco de brío.\""

# game/commonroute.rpy:1465
translate spanish commonroute_1c963487:

    # cl "\"A bit of what?\""
    cl "\"¿Un poco de qué?\""

# game/commonroute.rpy:1467
translate spanish commonroute_2a49e444:

    # cy "\"I can show you what I mean if you’re willing to spend the night with me.\""
    cy "\"Puedo mostrarte a qué me refiero si te apetece pasar la noche conmigo.\""

# game/commonroute.rpy:1468
translate spanish commonroute_d0769178:

    # "She winks at the weasel, giving him the shy trace of her best smile."
    "Le guiña un ojo a la comadreja y le dedica, con un toque de timidez, su mejor sonrisa."

# game/commonroute.rpy:1470
translate spanish commonroute_d2dad2df:

    # cl "\"A tempting offer, but if I must be honest, I am most curious about an experience with Sam, here.\""
    cl "\"Es una oferta tentadora, pero, para ser sincero, lo que más me interesa es tener una experiencia con Sam, aquí presente.\""

# game/commonroute.rpy:1472
translate spanish commonroute_73028603:

    # cl "\"If I’m stubborn enough to take a beating for that, then I’m stubborn enough to seek a unique opportunity.\""
    cl "\"Si soy lo bastante testarudo como para aguantar una paliza por eso, entonces también lo soy como para buscar una oportunidad única.\""

# game/commonroute.rpy:1473
translate spanish commonroute_53c0b1a2:

    # "The insides of the weasel’s ears blush."
    "El interior de las orejas de la comadreja se sonroja."

# game/commonroute.rpy:1474
translate spanish commonroute_44d7d671:

    # "The looks he’s giving me are a bit... passionate."
    "Las miradas que me lanza son un poco... apasionadas."

# game/commonroute.rpy:1475
translate spanish commonroute_4ccbcdf0:

    # "Not so much in a lusty way."
    "No tanto en un sentido lujurioso."

# game/commonroute.rpy:1476
translate spanish commonroute_cc2beaca:

    # "I’m afraid he might not understand that this is just a job."
    "Me temo que quizá no entienda que esto es solo un trabajo."

# game/commonroute.rpy:1477
translate spanish commonroute_42f2b88d:

    # "Perhaps that kiss was a mistake."
    "Quizá ese beso fuera un error."

# game/commonroute.rpy:1478
translate spanish commonroute_33983817:

    # "But anybody would have needed a kiss after putting up with... well, Echo."
    "Pero cualquiera habría necesitado un beso después de aguantar... bueno, a Echo."

# game/commonroute.rpy:1479
translate spanish commonroute_9f69b6d1:

    # m "\"I’m booked tonight, unfortunately.\""
    m "\"Por desgracia, esta noche ya estoy ocupado.\""

# game/commonroute.rpy:1480
translate spanish commonroute_9e8863ee:

    # "This isn’t even a lie."
    "Ni siquiera es mentira."

# game/commonroute.rpy:1481
translate spanish commonroute_1b658e3c:

    # "Nikolai is my regular today."
    "Hoy, Nikolai es mi cliente habitual."

# game/commonroute.rpy:1482
translate spanish commonroute_5b0b22e8:

    # "But it’s not unusual for Nik to suddenly cancel."
    "Pero no es raro que Nik cancele de repente."

# game/commonroute.rpy:1483
translate spanish commonroute_8f6c75c8:

    # "He’s not always the most reliable customer, even if he is a good friend."
    "No siempre es el cliente más fiable, aunque sea un buen amigo."

# game/commonroute.rpy:1485
translate spanish commonroute_7c46a732:

    # cl "\"Then I will double your usual price!\""
    cl "\"¡Entonces te pago el doble de lo que cobras normalmente!\""

# game/commonroute.rpy:1486
translate spanish commonroute_dc09fe9a:

    # "I want to put in that my bookings aren’t for sale to the highest bidder, but they utterly, earnestly are."
    "Quiero decir que mis citas no están a la venta para quien ofrezca más, pero, sinceramente, lo están."

# game/commonroute.rpy:1487
translate spanish commonroute_a9e0e31c:

    # "But Madam had warned me about passionate customers."
    "Pero Madam me había advertido sobre los clientes apasionados."

# game/commonroute.rpy:1488
translate spanish commonroute_7f85451f:

    # "Obsession can easily lead to heartbreak... and violence."
    "La obsesión puede llevar fácilmente al desengaño... y a la violencia."

# game/commonroute.rpy:1489
translate spanish commonroute_50f80080:

    # "I am not entirely sure yet that I want to take this weasel’s money."
    "Todavía no tengo del todo claro si quiero aceptar el dinero de esta comadreja."

# game/commonroute.rpy:1490
translate spanish commonroute_98a7f0dd:

    # m "\"I’ll consider if my regular client cancels, which happens often enough. But I can't guarantee an immediate booking without prior arrangements.\""
    m "\"Lo consideraré si mi cliente habitual cancela, lo cual sucede con bastante frecuencia. Pero no puedo garantizar una cita inmediata sin haberlo acordado previamente.\""

# game/commonroute.rpy:1491
translate spanish commonroute_3b5e5320:

    # "The weasel visibly wilts."
    "La comadreja se viene abajo visiblemente."

# game/commonroute.rpy:1493
translate spanish commonroute_cbbe1a4c:

    # cl "\"I do understand. You are a professional after all, and you have to ensure the health of your livelihood. I will make reservations if I cannot book tonight.\""
    cl "\"Lo entiendo. Al fin y al cabo, usted es un profesional y tiene que velar por la estabilidad de su sustento. Haré reservas si no puedo conseguir cita para esta noche.\""

# game/commonroute.rpy:1496
translate spanish commonroute_6d6b1dde:

    # cy "\"So is this the fella with cold feet, then?\""
    cy "\"Entonces, ¿es este el tipo al que le entran las dudas?\""

# game/commonroute.rpy:1497
translate spanish commonroute_b8add591:

    # "I try to figure out who Cynthia is talking about when I turn and jump, forgetting that the fox is still here."
    "Intento deducir de quién está hablando Cynthia cuando me giro y pego un salto, olvidando que el zorro sigue aquí."

# game/commonroute.rpy:1498
translate spanish commonroute_2cb49cbe:

    # "I’m a little bit unnerved by how quiet he can be."
    "Me pone un poco nervioso lo silencioso que puede llegar a ser."

# game/commonroute.rpy:1500
translate spanish commonroute_4a04be6d:

    # mu "\"Unfortunately not, my dear. I’m here for business, not for pleasure.\""
    mu "\"Por desgracia, no, querida. Estoy aquí por negocios, no por placer.\""

# game/commonroute.rpy:1501
translate spanish commonroute_be0d1260:

    # cy "\"But your pleasure is our business, aren’t I right, Sam?\""
    cy "\"Pero tu placer es nuestro negocio, ¿verdad, Sam?\""

# game/commonroute.rpy:1502
translate spanish commonroute_1827191a:

    # "I grunt."
    "Gruño."

# game/commonroute.rpy:1504
translate spanish commonroute_03ea0943:

    # mu "\"Then you should have charged me already. I’m having a lovely time just taking in the atmosphere.\""
    mu "\"Entonces ya deberías haberme cobrado. Lo estoy pasando de maravilla simplemente disfrutando del ambiente.\""

# game/commonroute.rpy:1505
translate spanish commonroute_1ed85299:

    # m "\"I can bill you by the hour if you’re that insistent.\""
    m "\"Si insistes tanto, puedo cobrarte por horas.\""

# game/commonroute.rpy:1506
translate spanish commonroute_8de8ff08:

    # "Murdoch chuckles."
    "Murdoch suelta una risita."

# game/commonroute.rpy:1507
translate spanish commonroute_e4e4a723:

    # mu "\"Not so much. I’m trained to think of ways to make money faster than I spend it.\""
    mu "\"No tanto. Estoy acostumbrado a pensar en formas de ganar dinero más rápido de lo que lo gasto.\""

# game/commonroute.rpy:1508
translate spanish commonroute_da96f001:

    # "Mock concern wells up in Cynthia’s tone."
    "En el tono de Cynthia aflora una fingida preocupación."

# game/commonroute.rpy:1510
translate spanish commonroute_693014de:

    # cy "\"So he’s after our jobs?\""
    cy "\"¿Así que va a por nuestros puestos de trabajo?\""

# game/commonroute.rpy:1511
translate spanish commonroute_19b03aa7:

    # "I remember a little irritably that he did imply that I should pay him as opposed to the other way around."
    "Recuerdo, con cierto fastidio, que dio a entender que yo debería pagarle a él, en lugar de al revés."

# game/commonroute.rpy:1513
translate spanish commonroute_33bd7c54:

    # mu "\"I don’t think I’m cut out for such a thing. But in another lifetime, perhaps even if I were, I’d have to be cut from a different cloth, so to speak.\""
    mu "\"No creo que esté hecho para algo así. Pero en otra vida, quizá incluso si lo fuera, tendría que estar hecho de otra pasta, por así decirlo.\""

# game/commonroute.rpy:1514
translate spanish commonroute_32c8efdb:

    # mu "\"My family is willful about how I spend my time and develop my trade.\""
    mu "\"Mi familia es muy inflexible en cuanto a cómo empleo mi tiempo y cómo desarrollo mi oficio.\""

# game/commonroute.rpy:1515
translate spanish commonroute_842b285b:

    # m "\"So the shorter story is that you’re a coward.\""
    m "\"En pocas palabras, eres un cobarde.\""

# game/commonroute.rpy:1516
translate spanish commonroute_1f6e554b:

    # cy "\"He’s right you know. I’ve heard that sob story before plenty of times.\""
    cy "\"La verdad es que tiene razón. Esa historia lacrimógena ya me la he oído un montón de veces.\""

# game/commonroute.rpy:1517
translate spanish commonroute_97ad7298:

    # m "\"Grow a spine and spend some of mommy’s money to slob on a knob.\""
    m "\"Ten huevos y gasta un poco del dinero de mamá en chupársela a alguien.\""

# game/commonroute.rpy:1519
translate spanish commonroute_4ce750d0:

    # "Cynthia sputters into raucous, chirpy laughter."
    "Cynthia suelta una carcajada estridente y alegre."

# game/commonroute.rpy:1520
translate spanish commonroute_b198a9cf:

    # "I think I imagined something."
    "Creo que me imaginé algo."

# game/commonroute.rpy:1522
translate spanish commonroute_59ca00cb:

    # "For a split second, there seems to be a cold, intense hatred coming from the fox that distorts and warps his friendly features."
    "Durante una fracción de segundo, parece que del zorro emana un odio frío e intenso que distorsiona y deforma sus rasgos amistosos."

# game/commonroute.rpy:1523
translate spanish commonroute_1346a918:

    # "Before I can process what I see, his mischievous smile is there again."
    "Antes de que pueda asimilar lo que veo, su sonrisa traviesa vuelve a aparecer."

# game/commonroute.rpy:1525
translate spanish commonroute_ee687bc4:

    # "There’s a jolly spark in his eyes."
    "Hay un brillo alegre en sus ojos."

# game/commonroute.rpy:1526
translate spanish commonroute_de16b1c2:

    # "I can sense nothing but warmth, now."
    "Ahora no percibo nada más que calidez."

# game/commonroute.rpy:1527
translate spanish commonroute_105f3e5f:

    # "I can only express this feeling as the onset of a migraine that stops the moment after it begins."
    "Solo puedo describir esta sensación como el inicio de una migraña que se detiene justo un instante después de empezar."

# game/commonroute.rpy:1528
translate spanish commonroute_b2809ae9:

    # mu "\"If you want a chance at my money that bad, I’ll spend a night. I mean it when I say I don’t intend to pay for sex.\""
    mu "\"Si tanto quieres tener una oportunidad de llevarte mi dinero, me quedo una noche. Hablo en serio cuando digo que no tengo intención de pagar por sexo.\""

# game/commonroute.rpy:1529
translate spanish commonroute_c3ed3cfd:

    # mu "\"But if we want to make this a point of personal pride, well, we’re going to have to hold a wager.\""
    mu "\"Pero si queremos convertir esto en una cuestión de orgullo personal, bueno, vamos a tener que hacer una apuesta.\""

# game/commonroute.rpy:1530
translate spanish commonroute_9b01a0b5:

    # mu "\"Five times your hourly rate to whoever has the best time.\""
    mu "\"Cinco veces tu tarifa por hora para quien se lo pase mejor.\""

# game/commonroute.rpy:1531
translate spanish commonroute_f891bc1b:

    # m "\"I’m not interested in any uncertainties. If you book me for the night, you pay.\""
    m "\"No me interesan las incertidumbres. Si me reservas para pasar la noche, pagas.\""

# game/commonroute.rpy:1533
translate spanish commonroute_7df2abb8:

    # mu "\"I’ve got far more than money to lose if I’m caught spending the night in a brothel.\""
    mu "\"Tengo mucho más que dinero que perder si me atrapan pasando la noche en un burdel.\""

# game/commonroute.rpy:1535
translate spanish commonroute_7e97f7b3:

    # mu "\"Now who’s the coward?\""
    mu "\"¿Y ahora quién es el cobarde?\""

# game/commonroute.rpy:1537
translate spanish commonroute_e6c59df5:

    # cy "\"Have a little more faith in your hips, Sam. Five for one is a great deal!\""
    cy "\"Ten un poco más de fe en tus caderas, Sam. ¡Cinco por uno es un excelente trato!\""

# game/commonroute.rpy:1539
translate spanish commonroute_77ac4895:

    # "She leans in close."
    "Se acerca mucho."

# game/commonroute.rpy:1540
translate spanish commonroute_14a3c333:

    # cy "\"That family’s wealthy enough to pay, too. They wouldn’t be hurting for much. And they’d squash any rumors about their own son.\""
    cy "\"Esa familia también tiene dinero suficiente para pagar. No les supondría un gran sacrificio. Y aplastarían cualquier rumor sobre su propio hijo.\""

# game/commonroute.rpy:1544
translate spanish commonroute_91df39a3:

    # "Several of the girls scream."
    "Varias de las chicas gritan."

# game/commonroute.rpy:1545
translate spanish commonroute_2abf6706:

    # "Cynthia looks at me, smirk wiped off of her face and her eyes full of concern."
    "Cynthia me mira; la sonrisa burlona desapareció de su rostro y sus ojos están llenos de preocupación."

# game/commonroute.rpy:1547
translate spanish commonroute_4ac133b7:

    # "There’s a low rumble outside that I recognize suddenly as the clamour of gathering voices."
    "Fuera se oye un murmullo bajo que, de pronto, reconozco como el clamor de voces que se van juntando."

# game/commonroute.rpy:1548
translate spanish commonroute_8754c079:

    # "I look outside of the window."
    "Miro por la ventana."

# game/commonroute.rpy:1549
translate spanish commonroute_ff2ba0dc:

    # "There are protesters arguing with one another."
    "Hay manifestantes discutiendo entre sí."

# game/commonroute.rpy:1550
translate spanish commonroute_441ebe46:

    # "Most of them appear to be miners."
    "La mayoría parece ser mineros."

# game/commonroute.rpy:1551
translate spanish commonroute_5e78c23a:

    # "Some of them are holding signs."
    "Algunos de ellos llevan pancartas."

# game/commonroute.rpy:1552
translate spanish commonroute_8a19e15f:

    # "One of those signs has the visage of a young Ram on it, but I can’t quite tell what the words say during the dark."
    "Una de esas pancartas lleva el rostro de un joven carnero, pero con la oscuridad no consigo distinguir bien qué dicen las palabras."

# game/commonroute.rpy:1553
translate spanish commonroute_4d8354aa:

    # "Another one of those signs has Jack’s face on it."
    "Otra de esas pancartas lleva la cara de Jack."

# game/commonroute.rpy:1554
translate spanish commonroute_f1c1b591:

    # "I feel something twist in my stomach."
    "Siento que algo se me retuerce en el estómago."

# game/commonroute.rpy:1555
translate spanish commonroute_31b00029:

    # "My fur bristles."
    "Se me eriza el pelo."

# game/commonroute.rpy:1556
translate spanish commonroute_096cb742:

    # "I suddenly feel alone in a room full of loud, frightened people."
    "De repente, me siento solo en una sala llena de gente ruidosa y asustada."

# game/commonroute.rpy:1557
translate spanish commonroute_7d2f564a:

    # "There’s a sudden feeling of hot breath on my neck."
    "De repente, siento un aliento caliente en el cuello."

# game/commonroute.rpy:1558
translate spanish commonroute_ca2cb94e:

    # "Like something wants to bite into my throat."
    "Como si algo quisiera clavarme los dientes en la garganta."

# game/commonroute.rpy:1559
translate spanish commonroute_3c3e320a:

    # "William’s booming voice brings me back."
    "La voz atronadora de William me devuelve a la realidad."

# game/commonroute.rpy:1560
translate spanish commonroute_38b32d5e:

    # wi "\"Everybody hunker down tonight. I don’t want to see a SINGLE SOUL wander out into those streets.\""
    wi "\"Esta noche, que todo el mundo se quede quieto y agache la cabeza. No quiero ver NI UNA SOLA ALMA merodeando por esas calles.\""

# game/commonroute.rpy:1561
translate spanish commonroute_2564b393:

    # cy "\"Looks like all of your prospects will have to stay, Sam.\""
    cy "\"Parece que todos tus clientes van a tener que quedarse, Sam.\""

# game/commonroute.rpy:1562
translate spanish commonroute_6c3a6138:

    # m "\"I can’t attend to all of them!\""
    m "\"¡No puedo atenderlos a todos!\""

# game/commonroute.rpy:1563
translate spanish commonroute_90524780:

    # cy "\"Then attend to one of them! We’re going to have to find somewhere for the rest.\""
    cy "\"¡Pues atiende a uno de ellos! Vamos a tener que buscar algún lugar para el resto.\""

translate spanish strings:

    # game/commonroute.rpy:1566
    old "Fit Cliff in for a booking."
    new "Hacerle un espacio a Cliff para una cita."

    # game/commonroute.rpy:1568
    old "Take on Murdoch’s bet."
    new "Aceptar la apuesta de Murdoch."

    # game/commonroute.rpy:1570
    old "See if Nikolai is here."
    new "Ver si Nikolai está aquí."

    # game/commonroute.rpy:1572
    old "Tell William the truth."
    new "Decirle la verdad a William."

