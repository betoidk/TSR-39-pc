        "Another glance."
        m "\"Row clea--\""
        play sound ("sfx/chittering.ogg")
        play music ("music/bedhorror.ogg") fadein 5.0
        scene bg auditoriumcoat1 with dis3
        "I see somebody on the floor."
        "No."
        "Something."

        "I see somebody’s eyes and smiling teeth shine back at me from cracked, burned skin."
        stop sound
        scene bg auditoriumcoat2 with dis
        "Then I just see a coat."
        "One of the ones Murdoch’s mother had him wear for picture day."
        play sound ("sfx/knifeopen.ogg")
