label schoolauditorium:
    if auditoriumvisit ==2:
        "We don’t have to walk very far to get to the entrance to the auditorium."
        play sound ("sfx/schooldoor.ogg")
        scene bg black with dissolve
        scene bg auditoriumnight with dis3
        "The double doors creak with a wheezy little whine as we slip into the giant room."
        stop sound
        if murdochchoices =="jim":
            show mur eyes talking suit at left,night:
                xzoom-1
        else:
            show mur eyes talking suit at right,night

        if murdochchoices =="ral":
            show ral stoic suit2 at left,night
        elif murdochchoices =="jim":
            show jim suit2 at right,night
        elif murdochchoices =="mel":
            show mel at left,night:
                xzoom-1
        with dis3
        mu "\"It doesn’t seem too long ago when we were just in here for picture day.\""
